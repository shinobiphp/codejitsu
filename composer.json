{
    "name": "shinobiphp/codejitsu",
    "description": "Modern PHP 8.4+ framework/toolkit for composable, intent driven applications",
    "type": "library",
    "require": {
        "php": ">=8.4",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/config": "^8.1",
        "symfony/finder": "^8.1",
        "symfony/filesystem": "^8.1",
        "vlucas/phpdotenv": "^5.6",
        "nette/neon": "^3.4",
        "opis/json-schema": "^2.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "license": "proprietary",
    "autoload": {
        "psr-4": {"Codejitsu\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Codejitsu\\Tests\\": "tests/"}
    },
    "authors": [{"name": "Shinobi PHP", "email": "shinobiphp@gmail.com"}],
    "config": {"bin-dir": "./bin/", "vendor-dir": "lib/"},
    "extra": {"branch-alias": {"dev-main": "1.0.x-dev"}},
    "scripts": {
        "test": "phpunit --exclude-group installation --enforce-time-limit --default-time-limit=10",
        "test:coverage": "phpunit --exclude-group installation --coverage-text --enforce-time-limit --default-time-limit=10",
        "test:installation": "phpunit --group installation --enforce-time-limit --default-time-limit=60",
        "check:php": "@php tools/check-php.php",
        "check:manifests": [
            "composer validate --strict",
            "composer validate --strict packages/core/composer.json",
            "composer validate --strict packages/discovery/composer.json",
            "composer validate --strict packages/scrolls/composer.json",
            "composer validate --strict packages/codex/composer.json",
            "composer validate --strict packages/config/composer.json",
            "composer validate --strict packages/schema/composer.json",
            "composer validate --strict packages/console/composer.json"
        ],
        "check": [
            "@check:manifests",
            "composer dump-autoload --optimize --strict-psr",
            "@check:php",
            "@test"
        ]
    }
}
