name: catalog-entry/catalog
type: schema
definition:
  type: object
  required: [identifier, kind, location]
  properties:
    identifier: {type: string, pattern: '^catalog://.+'}
    kind: {const: catalog}
    location: {type: string, pattern: '^[a-z][a-z0-9+.-]*://.+'}
    description: {type: string}
    metadata:
      type: object
      properties:
        enabled: {type: boolean}
        priority: {type: integer}
        access: {enum: [writable, read-only]}
