{
    "name": "codejitsu/runtimes",
    "description": "Collection of runtimes and runtime substrates for codejitsu",
    "type": "codejitsu-pkg",
    "license": "proprietary",
    "extra": {
        "codejitsu": {
            "manifest": "codejitsu.package"
        }
    },
    "require": {
        "php": ">=8.4",
        "codejitsu/core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Codejitsu\\Runtimes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Codejitsu\\Runtimes\\Tests\\": "tests/"
        }
    }
}
