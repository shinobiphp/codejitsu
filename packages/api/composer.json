{
    "name": "codejitsu/api",
    "description": "REST, GraphQL, MCP, A2U, A2A and other API related classes",
    "type": "codejitsu-pkg",
    "license": "proprietary",
    "extra": {
        "codejitsu": {
            "manifest": "codejitsu.package"
        }
    },
    "require": {
        "php": ">=8.4",
        "codejitsu/core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Codejitsu\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Codejitsu\\Api\\Tests\\": "tests/"
        }
    }
}
