{
    "name": "codejitsu/buildshido",
    "description": "The compiler, static analysis, optimizer, linter, etc... for codejitsu",
    "type": "codejitsu-pkg",
    "license": "proprietary",
    "extra": {
        "codejitsu": {
            "manifest": "codejitsu.package"
        }
    },
    "require": {
        "php": ">=8.4",
        "codejitsu/core": "self.version",
        "codejitsu/scrolls": "self.version",
        "codejitsu/codex": "self.version",
        "codejitsu/schema": "self.version",
        "codejitsu/console": "self.version",
        "codejitsu/context": "self.version"
    },
    "require-dev": {
        "codejitsu/package": "self.version",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "Codejitsu\\Buildshido\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Codejitsu\\Buildshido\\Tests\\": "tests/"
        }
    }
}
