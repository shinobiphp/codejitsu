{
    "name": "codejitsu/data",
    "description": "Data modeling/stores and database access with utilities",
    "type": "codejitsu-pkg",
    "license": "proprietary",
    "extra": {
        "codejitsu": {
            "manifest": "codejitsu.package"
        }
    },
    "require": {
        "php": ">=8.4",
        "codejitsu/core": "self.version"
    },
    "autoload": {
        "psr-4": {
