{
    "name": "codejitsu/package",
    "description": "Codejitsu package manifests, compilation, and runtime registration",
    "type": "codejitsu-pkg",
    "license": "proprietary",
    "extra": {"codejitsu": {"manifest": "codejitsu.package"}},
    "require": {
        "php": ">=8.4",
        "codejitsu/core": "self.version",
        "codejitsu/scrolls": "self.version",
        "codejitsu/codex": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Codejitsu\\Packages\\": "../../src/Packages/",
            "Codejitsu\\Contracts\\Packages\\": "../../src/Contracts/Packages/"
        }
    }
}
