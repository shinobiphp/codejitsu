name: codejitsu/ai
version: 0.1.0
description: 'Provider-neutral AI agents, harnesses, skills, and tools.'
setup:
  model: {target: Codejitsu\Ai\Models\ModelPackageSetup, optional: true, interactive: true}
capabilities:
  provides: [ai-runtime, spark-agents, ai-tools]
  requires: [core-runtime, scroll-resources, resource-codex, schema-validation, console-runtime, context-memory]
types:
  spark:
    plural: sparks
    extension: spark
    scheme: spark://
    class: Codejitsu\Ai\Scrolls\Spark
    codec: neon
  vessel:
    plural: vessels
    extension: vessel
    scheme: vessel://
    class: Codejitsu\Ai\Scrolls\Vessel
    codec: neon
  provider:
    plural: providers
    extension: provider
    scheme: provider://
    class: Codejitsu\Ai\Scrolls\Provider
    codec: neon
  model:
    plural: models
    extension: model
    scheme: model://
    class: Codejitsu\Ai\Scrolls\Model
    codec: neon
  tool:
    plural: tools
    extension: tool
    scheme: tool://
    class: Codejitsu\Ai\Scrolls\Tool
    codec: neon
  toolset:
    plural: toolsets
    extension: toolset
    scheme: toolset://
    class: Codejitsu\Ai\Scrolls\Toolset
    codec: neon
sources:
  codejitsu-ai:
    path: resources
