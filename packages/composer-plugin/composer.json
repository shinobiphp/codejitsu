{
    "name": "codejitsu/composer-plugin",
    "description": "Keeps the Codejitsu package cache synchronized with Composer",
    "type": "composer-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "composer-plugin-api": "^2.6",
        "codejitsu/package": "self.version"
    },
    "autoload": {"psr-4": {"Codejitsu\\Composer\\": "src/"}},
    "extra": {"class": "Codejitsu\\Composer\\Plugin"}
}
